{
  "mcpServers": {
    "attack-lens": {
      "command": "/usr/bin/python3",
      "args": [
        "-m",
        "src.mcp.mcp_server"
      ],
      "cwd": "/path/to/project/AttackLens",
      "env": {
        "ATTACKLENS_CONFIG_FILE": "/path/to/project/AttackLens/config.json",
        "PYTHONPATH": "/path/to/project/AttackLens"
      }
    }
  }
}

