# SamiGPT - example environment file
#
# Copy this file to `.env` (already gitignored — never commit real secrets)
# and fill in the values for your environment. `.env` is loaded
# automatically at startup via python-dotenv (see src/core/config.py).
#
# Only the SIEM (Elastic/OpenSearch) section below is currently wired end
# to end for the running MCP server (src/mcp/mcp_server.py); it is the
# authoritative way to configure that integration and always takes
# priority over any "elastic" section in config.json. Other integrations
# (case management, EDR, CTI, engineering) are still configured via
# config.json — see config.json.example.

# ---------------------------------------------------------------------------
# SIEM: Elasticsearch / OpenSearch
# ---------------------------------------------------------------------------
# Base URL of your Elasticsearch or OpenSearch cluster. Required for the
# SIEM integration to be enabled — if unset, SIEM tools are not registered.
# This is never hardcoded in source; it always comes from this variable.
#
# Example for a local OpenSearch instance (e.g. `docker run -p 9200:9200 ...`):
SAMIGPT_ELASTIC_URL=http://localhost:9200

# Optional authentication (leave unset for a local OpenSearch instance
# running without the security plugin, which is the common dev setup).
# SAMIGPT_ELASTIC_API_KEY=
# SAMIGPT_ELASTIC_USERNAME=
# SAMIGPT_ELASTIC_PASSWORD=

SAMIGPT_ELASTIC_TIMEOUT_SECONDS=30

# DEV-ONLY: disables TLS certificate verification for the SIEM HTTP client.
# Only set this to "false" when connecting to a local/dev instance over
# plain HTTP (as above) or a self-signed local HTTPS setup. NEVER set this
# to "false" against a staging or production cluster reachable outside your
# machine — it disables protection against man-in-the-middle attacks.
SAMIGPT_ELASTIC_VERIFY_SSL=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# SAMIGPT_LOG_DIR=logs
# SAMIGPT_LOG_LEVEL=INFO
